# Jadwa (جدوى) Environment Configuration
# Copy this file to .env or set environment variables in your deployment

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anon API Key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Demo User Credentials for Hackathon / Guest One-Click Access
VITE_DEMO_USER_EMAIL=demo@jadwa.app
VITE_DEMO_USER_PASSWORD=JadwaDemo2026!
